#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?SomaFM Bar requires XDG_RUNTIME_DIR}"
runtime_dir="$XDG_RUNTIME_DIR/somafm-bar"
data_root=${XDG_DATA_HOME:-$HOME/.local/share}
state_file="$data_root/somafm-bar/state.json"
socket="$runtime_dir/mpvd.sock"
status_file="$runtime_dir/status.json"
pid_file="$runtime_dir/player.pid"
log_file="$runtime_dir/mpv.log"
max_json_bytes=4194304
max_ipc_bytes=65536
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
status_script="$script_dir/player-status.lua"
install -d -m 700 "$runtime_dir" "$data_root/somafm-bar"
exec 8>"$runtime_dir/player.lock"

override_file="$data_root/somafm-bar/override.json"
channels_cache="$data_root/somafm-bar/channels-cache.json"
favorites_file="$data_root/somafm-bar/favorites.json"
airplay_config="$data_root/somafm-bar/airplay.json"
airplay_state="$runtime_dir/airplay.json"
airplay_bridge_script="$script_dir/airplay-bridge"
fun_bridge_script="$script_dir/fun-bridge"

load_override() {
  [[ -f $override_file ]] || return 0
  jq -e '.url|type=="string"' "$override_file" >/dev/null 2>&1 || return 0
  jq -e '.name|type=="string"' "$override_file" >/dev/null 2>&1 || return 0
}

station_url() {
  load_override || true
  local url
  if [[ -f $override_file ]]; then
    url=$(jq -r '.url // ""' "$override_file" 2>/dev/null || true)
  fi
  if [[ -z $url || ($url != http://* && $url != https://*) ]]; then
    url=$(jq -r '.url // ""' "$script_dir/config.json" 2>/dev/null || true)
  fi
  if [[ $url != http://* && $url != https://* ]]; then
    url="http://ice6.somafm.com/bossa-128-mp3"
  fi
  printf '%s\n' "$url"
}

station_name() {
  load_override || true
  local name=""
  if [[ -f $override_file ]]; then
    name=$(jq -r '(.name // "") | if type == "string" then . else "" end' "$override_file" 2>/dev/null || true)
  fi
  if [[ -z $name ]]; then
    name=$(jq -r '(.station // "") | if type == "string" then . else "" end' "$script_dir/config.json" 2>/dev/null || true)
  fi
  name=$(printf '%s' "$name" | tr -d '[:cntrl:]' | cut -c1-80)
  printf '%s\n' "${name:-SomaFM}"
}

player_idle() {
  local response
  response=$(printf '%s\n' '{"command":["get_property","idle-active"],"request_id":9002}' \
    | socat -T 1 - "UNIX-CONNECT:$socket" 2>/dev/null \
    | head -c "$((max_ipc_bytes + 1))") || return 1
  (( $(printf '%s' "$response" | wc -c) <= max_ipc_bytes )) || return 1
  jq -e 'select(.request_id == 9002 and .error == "success") | .data == true' \
    <<< "$response" >/dev/null 2>&1
}

player_paused() {
  local response
  response=$(printf '%s\n' '{"command":["get_property","pause"],"request_id":9003}' \
    | socat -T 1 - "UNIX-CONNECT:$socket" 2>/dev/null \
    | head -c "$((max_ipc_bytes + 1))") || return 1
  (( $(printf '%s' "$response" | wc -c) <= max_ipc_bytes )) || return 1
  jq -e 'select(.request_id == 9003 and .error == "success") | .data == true' \
    <<< "$response" >/dev/null 2>&1
}

process_start_time() {
  local pid=$1
  [[ -r /proc/$pid/stat ]] || return 1
  awk '$3 != "Z" { print $22 }' "/proc/$pid/stat" 2>/dev/null
}

player_alive() {
  local pid expected_start actual_start
  [[ -s $pid_file ]] || return 1
  read -r pid expected_start < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && $expected_start =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual_start=$(process_start_time "$pid") || return 1
  [[ $actual_start == "$expected_start" ]]
}

write_player_pid() {
  local pid=$1
  local start_time temporary
  start_time=$(process_start_time "$pid") || return 1
  temporary=$(mktemp "$runtime_dir/player.XXXXXX")
  printf '%s %s\n' "$pid" "$start_time" > "$temporary"
  mv "$temporary" "$pid_file"
}

cleanup_dead_player() {
  player_alive && return
  rm -f "$pid_file" "$socket"
}

terminate_tracked_player() {
  local pid
  player_alive || return 0
  read -r pid _ < "$pid_file"
  kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 100); do
    player_alive || break
    sleep 0.02
  done
  if player_alive; then
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      player_alive || break
      sleep 0.02
    done
  fi
  player_alive && return 1
  cleanup_dead_player
}

configured_number() {
  local key=$1 default=$2
  local value
  value=$(jq -r --arg key "$key" --argjson default "$default" '
    (.[$key] // $default | tonumber? // empty)
    | if . < 0 then 0 elif . > 100 then 100 else . end' \
    "$state_file" 2>/dev/null) || value=$default
  printf '%s\n' "$value"
}

configured_volume() {
  configured_number volume 70
}

configured_output() {
  local output
  output=$(jq -r '(.output // "") | if (type == "string"
    and test("^([A-Za-z0-9._:+-]{0,160})$")) then . else "" end' \
    "$state_file" 2>/dev/null) || output=""
  printf '%s\n' "$output"
}

resolve_output() {
  local requested=${1-}
  [[ -n $requested ]] || return 0
  local available
  available=$(list_outputs 2>/dev/null) || { printf '%s\n' "$requested"; return 0; }
  [[ -n $available ]] || { printf '%s\n' "$requested"; return 0; }
  if jq -e --arg r "$requested" 'any(.outputs[]; .id == $r)' \
      <<< "$available" >/dev/null 2>&1; then
    printf '%s\n' "$requested"
    return 0
  fi
  local match
  match=$(jq -r --arg r "$requested" '
    ($r | capture("^(?<pre>.*?)(\\.([0-9]{1,3}\\.){3}[0-9]{1,3}\\.[0-9]+)?$").pre) as $pre
    | [.outputs[] | select(.id == $pre or (.id | startswith($pre + ".")))][0].id // ""
  ' <<< "$available" 2>/dev/null) || match=""
  if [[ -n $match ]]; then printf '%s\n' "$match"; else printf '%s\n' "$requested"; fi
}

resolved_configured_output() {
  resolve_output "$(configured_output)"
}

airplay_targets_json() {
  [[ -f $airplay_config ]] || { printf '[]\n'; return 0; }
  jq -c '[ (.targets // [])[] | select((.id | type) == "string")
    | {id: .id, label: ("AirPlay 2 (" + ((.name // "AirPlay") | tostring) + ")")} ]' \
    "$airplay_config" 2>/dev/null || printf '[]\n'
}

is_airplay_output() {
  local id=${1-}
  [[ -n $id && -f $airplay_config ]] || return 1
  jq -e --arg id "$id" 'any((.targets // [])[]; .id == $id)' "$airplay_config" >/dev/null 2>&1
}

airplay_bridge() {
  [[ -x $airplay_bridge_script ]] || return 1
  "$airplay_bridge_script" "$@" 8>&-
}

airplay_running_id() {
  [[ -f $airplay_state ]] || return 0
  jq -r '.id // empty' "$airplay_state" 2>/dev/null
}

start_airplay_output() {
  local id=${1-}
  [[ -n $id ]] || return 0
  is_airplay_output "$id" || return 0
  if airplay_bridge running >/dev/null 2>&1 && [[ $(airplay_running_id) == "$id" ]]; then
    airplay_bridge resume >/dev/null 2>&1 || true
    return 0
  fi
  airplay_bridge start-async "$id" >/dev/null 2>&1 || {
    echo 'AirPlay output could not be started' >&2
    return 1
  }
}

write_status() {
  local state=$1
  local temporary
  if (( $(printf '%s' "$state" | wc -c) > max_ipc_bytes )); then
    echo 'Soma player returned an oversized status' >&2
    return 4
  fi
  temporary=$(mktemp "$runtime_dir/status.XXXXXX")
  printf '%s\n' "$state" > "$temporary"
  mv "$temporary" "$status_file"
  printf '%s\n' "$state"
}

send_command() {
  local payload=$1
  local request_id=9001
  local response
  [[ -S $socket ]] || return 1
  payload=$(jq -c --argjson requestId "$request_id" '. + {request_id: $requestId}' <<< "$payload") || return 1
  response=$(printf '%s\n' "$payload" \
    | socat -T 1 - "UNIX-CONNECT:$socket" 2>/dev/null \
    | head -c "$((max_ipc_bytes + 1))") || return 1
  (( $(printf '%s' "$response" | wc -c) <= max_ipc_bytes )) || return 1
  jq -e --argjson requestId "$request_id" \
    'select(.request_id == $requestId and .error == "success")' \
    <<< "$response" >/dev/null 2>&1
}

not_running_status() {
  jq -cn \
    --argjson volume "$(configured_volume)" \
    --arg output "$(resolved_configured_output)" \
    --arg station "$(station_name)" \
    --arg url "$(station_url)" \
    '{running:false,paused:false,muted:false,title:"",volume:$volume,output:$output,url:$url,loaded:false,error:"",errorDetail:"",station:{name:$station}}'
}

status() {
  if [[ ! -S $socket ]]; then
    cleanup_dead_player
    write_status "$(not_running_status)"
    return
  fi

  local response
  response=$(
    printf '%s\n' \
      '{"command":["get_property","pause"],"request_id":1}' \
      '{"command":["get_property","media-title"],"request_id":2}' \
      '{"command":["get_property","volume"],"request_id":3}' \
      '{"command":["get_property","mute"],"request_id":4}' \
      '{"command":["get_property","audio-device"],"request_id":5}' \
      '{"command":["get_property","idle-active"],"request_id":6}' \
      | socat -T 1 - "UNIX-CONNECT:$socket" 2>/dev/null \
      | head -c "$((max_ipc_bytes + 1))" || true
  )
  if (( $(printf '%s' "$response" | wc -c) > max_ipc_bytes )); then
    response=""
  fi

  if ! jq -e 'select(.request_id == 1)' <<< "$response" >/dev/null 2>&1; then
    cleanup_dead_player
    write_status "$(not_running_status)"
    return
  fi

  printf '%s\n' "$(jq -sc --arg station "$(station_name)" --arg url "$(station_url)" '
    {
      running: (([.[] | select(.request_id == 6) | .data][0] // false) == false),
      paused: ([.[] | select(.request_id == 1) | .data][0] // false),
      muted: ([.[] | select(.request_id == 4) | .data][0] // false),
      title: (([.[] | select(.request_id == 2) | .data][0] // "")
        | if type == "string" then gsub("[\\r\\n\\t]"; " ")[:512] else "" end),
      volume: ([.[] | select(.request_id == 3) | .data][0] // 70),
      output: (([.[] | select(.request_id == 5) | .data][0] // "")
        | if type == "string" then (if . == "auto" then "" else sub("^pipewire/"; "") end) else "" end),
      url: $url,
      loaded: true,
      error: "",
      errorDetail: "",
      station: {name: $station}
    }' <<< "$response")"
}

player_command() {
  local payload=$1
  if ! send_command "$payload"; then
    status >/dev/null
    echo 'Soma player is unavailable' >&2
    exit 4
  fi
  status
}

start_player() {
  local url
  url=$(station_url)
  local -a player_arguments=(
    mpv
    --no-video
    --force-window=no
    --audio-display=no
    --idle=yes
    --cache-secs=20
    --demuxer-max-bytes=8MiB
    --demuxer-max-back-bytes=2MiB
    --network-timeout=30
    --volume="$(configured_volume)"
    --volume-max=100
    --input-ipc-server="$socket"
    --script="$status_script"
    --no-terminal
    --really-quiet
    "$url"
  )
  local selected_output
  selected_output=$(resolved_configured_output)
  if [[ -n $selected_output ]]; then
    if is_airplay_output "$selected_output" && ! start_airplay_output "$selected_output"; then
      exit 4
    fi
    player_arguments+=(--audio-device="pipewire/$selected_output")
  fi
  rm -f "$socket"
  SOMA_STATUS_FILE="$status_file" SOMA_STATION="$(station_name)" setsid "${player_arguments[@]}" \
    > "$log_file" 2>&1 8>&- &
  local player_pid=$!
  if ! write_player_pid "$player_pid"; then
    kill -- "-$player_pid" 2>/dev/null || kill "$player_pid" 2>/dev/null || true
    wait "$player_pid" 2>/dev/null || true
    rm -f "$socket"
    echo 'Soma player could not start' >&2
    exit 4
  fi

  for _ in $(seq 1 150); do
    [[ -S $socket ]] && break
    sleep 0.02
  done
  if [[ ! -S $socket ]]; then
    terminate_tracked_player || true
    wait "$player_pid" 2>/dev/null || true
    rm -f "$socket"
    echo 'Soma player could not start' >&2
    exit 4
  fi
}

reload_if_idle() {
  player_idle || return 0
  send_command "$(jq -cn --arg url "$(station_url)" '{command:["loadfile",$url,"replace"]}')" || true
}

play() {
  if [[ ! -S $socket ]] && ! player_alive; then
    start_player
  fi
  if ! reload_if_idle || ! send_command '{"command":["set_property","pause",false]}'; then
    if [[ -S $socket ]] || player_alive; then
      status >/dev/null
      echo 'Soma player could not start playback' >&2
      exit 4
    fi
    start_player
    send_command '{"command":["set_property","pause",false]}' >/dev/null || {
      status >/dev/null
      echo 'Soma player could not start playback' >&2
      exit 4
    }
  fi
  local selected_output
  selected_output=$(resolved_configured_output)
  if is_airplay_output "$selected_output"; then
    if [[ $(airplay_running_id) == "$selected_output" ]]; then
      airplay_bridge resume >/dev/null 2>&1 || true
    else
      start_airplay_output "$selected_output" >/dev/null 2>&1 || true
    fi
  fi
  status
}

stop_player() {
  airplay_bridge park >/dev/null 2>&1 || true
  if [[ ! -S $socket ]]; then
    if ! terminate_tracked_player; then
      echo 'Soma player could not be stopped' >&2
      exit 4
    fi
    status
    return
  fi

  if ! send_command '{"command":["quit"]}'; then
    if ! terminate_tracked_player; then
      echo 'Soma player could not be stopped' >&2
      exit 4
    fi
    status
    return
  fi

  for _ in $(seq 1 100); do
    if [[ ! -S $socket ]] && ! player_alive; then
      break
    fi
    sleep 0.02
  done
  if { [[ -S $socket ]] || player_alive; } && ! terminate_tracked_player; then
    echo 'Soma player could not be stopped' >&2
    exit 4
  fi
  status
}

set_volume() {
  local volume=${1:-}
  [[ $volume =~ ^[0-9]+$ ]] || { echo 'Volume must be an integer from 0 to 100' >&2; exit 2; }
  (( volume >= 0 && volume <= 100 )) || { echo 'Volume must be an integer from 0 to 100' >&2; exit 2; }
  local temporary
  temporary=$(mktemp "$runtime_dir/state.XXXXXX")
  jq -S --argjson volume "$volume" '.volume = $volume' "$state_file" > "$temporary" 2>/dev/null \
    || jq -S -n --argjson volume "$volume" '{volume: $volume}' > "$temporary"
  mv "$temporary" "$state_file"

  if [[ -S $socket ]]; then
    local command
    command=$(jq -cn --argjson volume "$volume" '{command:["set_property","volume",$volume]}')
    if ! send_command "$command"; then
      status >/dev/null
      if [[ -S $socket ]]; then
        echo 'Soma volume could not be changed' >&2
        exit 4
      fi
    fi
  fi
  status
}

adjust_volume() {
  local delta=$1
  local current
  current=$(status | jq -r '.volume | round')
  local next=$((current + delta))
  (( next < 0 )) && next=0
  (( next > 100 )) && next=100
  set_volume "$next"
}

list_outputs() {
  local sinks
  sinks=$(pactl -f json list sinks 2>/dev/null) || {
    echo 'Audio outputs are unavailable' >&2
    exit 3
  }
  if (( $(printf '%s' "$sinks" | wc -c) > max_json_bytes )) \
    || ! jq -e 'type == "array"' <<< "$sinks" >/dev/null 2>&1; then
    echo 'Audio outputs are unavailable' >&2
    exit 3
  fi
  printf '%s' "$sinks" | jq -c --argjson airplay "$(airplay_targets_json)" '
    ($airplay | map(.id)) as $airplay_ids
    | [
        .[] | select(type == "object" and (.name | type == "string"))
        | .name as $id
        | select($id | test("^([A-Za-z0-9._:+-]{1,160})$"))
        | select(($airplay_ids | index($id)) | not)
        | {id: $id, label: ((.description // $id) | tostring | gsub("[\\r\\n\\t]"; " ") | .[:160])}
      ] + $airplay
    | {outputs: .}'
}

set_output() {
  local requested=${1-}
  if [[ -n $requested ]]; then
    [[ $requested =~ ^[A-Za-z0-9._:+-]{1,160}$ ]] || {
      echo 'Unknown audio output' >&2
      exit 2
    }
    local available
    available=$(list_outputs)
    jq -e --arg requested "$requested" 'any(.outputs[]; .id == $requested)' \
      <<< "$available" >/dev/null || {
      echo 'Unknown audio output' >&2
      exit 3
    }
  fi

  local previous_airplay
  previous_airplay=$(airplay_running_id)
  if [[ -n $requested ]] && is_airplay_output "$requested" && [[ -S $socket ]]; then
    if ! start_airplay_output "$requested" >/dev/null 2>&1; then
      echo 'AirPlay output could not be started' >&2
      status >/dev/null
      exit 4
    fi
    if player_idle || player_paused; then
      airplay_bridge park >/dev/null 2>&1 || true
    fi
  fi

  local temporary
  temporary=$(mktemp "$runtime_dir/state.XXXXXX")
  jq -S --arg output "$requested" '.output = $output' "$state_file" > "$temporary" 2>/dev/null \
    || jq -S -n --arg output "$requested" '{output: $output}' > "$temporary"
  mv "$temporary" "$state_file"

  if [[ -S $socket ]]; then
    local device command
    device=auto
    [[ -z $requested ]] || device="pipewire/$requested"
    command=$(jq -cn --arg device "$device" '{command:["set_property","audio-device",$device]}')
    if ! send_command "$command"; then
      status >/dev/null
      if [[ -S $socket ]]; then
        echo 'Audio output could not be changed' >&2
        exit 4
      fi
    fi
  fi

  # Tear the old AirPlay session down only after mpv has been moved off its
  # sink. Disconnecting first unloads the sink out from under the playing
  # mpv, which makes mpv pause; switching the device first keeps playback.
  if [[ -n $previous_airplay && $previous_airplay != "$requested" ]]; then
    local running_now
    running_now=$(airplay_running_id)
    if [[ $running_now == "$previous_airplay" ]]; then
      airplay_bridge disconnect >/dev/null 2>&1 || true
    fi
  fi
  status
}

action=${1:-status}
[[ $action == play || $action == outputs || $action == fun ]] || flock -x 8



fetch_stations_json() {
  local now ttl=3600
  now=$(date +%s 2>/dev/null || echo 0)
  if [[ -f $channels_cache ]]; then
    local mtime
    mtime=$(stat -c %Y "$channels_cache" 2>/dev/null || echo 0)
    if (( now - mtime < ttl )); then
      cat "$channels_cache"
      return 0
    fi
  fi
  local tmp
  tmp=$(mktemp "$data_root/somafm-bar/ch.XXXXXX.json")
  if curl -s --max-time 25 "https://somafm.com/channels.json" > "$tmp" 2>/dev/null; then
    if jq -e 'has("channels") and (.channels|type=="array")' "$tmp" >/dev/null 2>&1; then
      mv "$tmp" "$channels_cache"
      cat "$channels_cache"
      return 0
    fi
  fi
  rm -f "$tmp"
  [[ -f $channels_cache ]] && cat "$channels_cache" || echo '{"channels":[]}'
}

normalize_stations() {
  fetch_stations_json | jq -c '
    [.channels[] | select(type=="object") | .id as $id | .title as $title | .description as $desc |
      (try (.playlists[] | select(.format|tostring|contains("mp3"))) catch null) as $p |
      ($p // {}) as $pl |
      ($id|tostring|gsub("[[:space:]]+";"")) as $sid |
      (if ($pl.url|type=="string") then $pl.url else ("https://ice2.somafm.com/"+$sid+"-128-mp3") end) as $url |
      select($url|test("^https?://")) |
      {
        id: $sid,
        name: ($title|tostring|gsub("[\\r\\n\\t]";" ")|.[0:120]),
        title: ($title|tostring|gsub("[\\r\\n\\t]";" ")|.[0:120]),
        description: ($desc|tostring|gsub("[\\r\\n\\t]";" ")|.[0:400]),
        url: $url
      }
    ] | unique_by(.url) | sort_by(.name)'
}

stations_cmd() {
  normalize_stations
}

fav_ensure() {
  [[ -f $favorites_file ]] || echo '{"stations":[]}' > "$favorites_file"
  jq -e '.stations|type=="array"' "$favorites_file" >/dev/null 2>&1 || echo '{"stations":[]}' > "$favorites_file"
}

fav_list() {
  fav_ensure
  jq -c '.stations' "$favorites_file"
}

fav_add() {
  local name=${1-} url=${2-}
  [[ -n $name && -n $url ]] || { echo 'Invalid favorite' >&2; exit 2; }
  fav_ensure
  local tmp
  tmp=$(mktemp "$data_root/somafm-bar/fav.XXXXXX.json")
  jq --arg n "$name" --arg u "$url" '.stations |= ([{name:$n,url:$u}] + map(select(.url != $u))) | .stations |= .[0:200]' "$favorites_file" > "$tmp"
  mv "$tmp" "$favorites_file"
  fav_list
}

fav_remove() {
  local url=${1-}
  [[ -n $url ]] || { echo 'Invalid favorite' >&2; exit 2; }
  fav_ensure
  local tmp
  tmp=$(mktemp "$data_root/somafm-bar/fav.XXXXXX.json")
  jq --arg u "$url" '.stations |= map(select(.url != $u))' "$favorites_file" > "$tmp"
  mv "$tmp" "$favorites_file"
  fav_list
}

switch_station() {
  local name=${1-} url=${2-}
  [[ -n $name && -n $url ]] || { echo 'Invalid station' >&2; exit 2; }
  [[ $url == http://* || $url == https://* ]] || { echo 'Invalid URL' >&2; exit 2; }
  local tmp
  tmp=$(mktemp "$data_root/somafm-bar/ovr.XXXXXX.json")
  jq -n --arg n "$name" --arg u "$url" '{name:$n,url:$u}' > "$tmp"
  mv "$tmp" "$override_file"
  if [[ -S $socket ]]; then
    reload_if_idle || send_command "$(jq -cn --arg url "$url" '{command:["loadfile",$url,"replace"]}')" >/dev/null 2>&1 || true
    send_command '{"command":["set_property","pause",false]}' >/dev/null 2>&1 || true
  else
    player_alive || true
  fi
  SOMA_STATION="$(station_name)" status >/dev/null 2>&1 || status
}

case "$action" in
  play)
    play
    ;;
  toggle)
    if player_idle; then
      play
    elif [[ $(status | jq -r '.paused' 2>/dev/null) == true ]]; then
      play
    else
      airplay_bridge pause >/dev/null 2>&1 || true
      player_command '{"command":["cycle","pause"]}'
    fi
    ;;
  pause)
    airplay_bridge pause >/dev/null 2>&1 || true
    player_command '{"command":["set_property","pause",true]}'
    ;;
  stop)
    stop_player
    ;;
  volume)
    set_volume "${2:-}"
    ;;
  volume-up)
    adjust_volume 5
    ;;
  volume-down)
    adjust_volume -5
    ;;
  outputs)
    list_outputs
    ;;
  output)
    set_output "${2-}"
    ;;
  status)
    status
    ;;
  stations)
    stations_cmd
    ;;
  fav-list)
    fav_list
    ;;
  fav-add)
    fav_add "${2-}" "${3-}"
    ;;
  fav-remove)
    fav_remove "${2-}"
    ;;
  switch)
    switch_station "${2-}" "${3-}"
    ;;
  set-station)
    switch_station "${2-}" "${3-}"
    ;;
  fun)
    [[ -x $fun_bridge_script ]] || { echo 'Fun engine is unavailable' >&2; exit 4; }
    exec "$fun_bridge_script" "${@:2}"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 2
    ;;
esac
